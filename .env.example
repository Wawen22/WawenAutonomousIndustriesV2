# =============================================================
# WAI – Environment Variables Template
# Copia questo file in .env e compila i valori.
# NON committare .env su git.
# =============================================================

# --- LiteLLM (proxy LLM unificato — gateway per tutti i modelli) ---
# Internamente: http://litellm:4000/v1 (Docker network)
# In locale (fuori Docker): http://localhost:4000/v1
LITELLM_BASE_URL=http://litellm:4000/v1
LITELLM_API_KEY=sk-wai-master-key

# --- Azure OpenAI (GPT-5.4) — configurato in LiteLLM ---
AZURE_OPENAI_API_KEY=your-azure-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT_GPT54=gpt-5.4
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# --- Google Gemini — configurato in LiteLLM ---
GOOGLE_AI_API_KEY=your-google-ai-api-key

# --- Supabase (Cloud — crea nuovo progetto su supabase.com) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_FOUNDER_CHAT_ID=your-telegram-user-id
TELEGRAM_BOT_USERNAME=your-bot-username

# --- GitHub ---
GITHUB_TOKEN=your-github-pat
GITHUB_ORG=wawen-ai

# --- Email (Resend) ---
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# --- Web Search (Serper.dev) ---
SERPER_API_KEY=your-serper-api-key
SERPER_BASE_URL=https://google.serper.dev/search
# Optional localization defaults
SERPER_GL=it
SERPER_HL=it

# --- Slack ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# --- App ---
NODE_ENV=development
LOG_LEVEL=info
PORT=3001
DASHBOARD_PORT=3000
BACKEND_PORT=3001

# --- Budget Alerts ---
MONTHLY_BUDGET_USD=500
ALERT_THRESHOLD_PERCENT=80
